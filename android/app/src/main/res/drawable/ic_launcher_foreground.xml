<?xml version="1.0" encoding="utf-8"?>
<!-- Icono: P4P, con el 4 en rojo, que es la marca del juego.

     Dibujado como vector y no como PNG para no meter binarios en el repositorio, y a base
     de rectángulos y no de curvas porque a 48 px una letra con curvas se emborrona y una
     condensada de palo recto no. El 4 va de canto cuadrado a propósito: es el mismo
     lenguaje que los marcos de las cartas.

     Todo cabe dentro del círculo de 66 dp que Android garantiza que no recorta: el texto
     ocupa de x=25 a x=83 y de y=40 a y=68, y su esquina más lejana queda a 32 del centro,
     por debajo del radio de 33. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- P -->
    <path android:fillColor="#F8F5EE" android:pathData="M25,40h5.5v28h-5.5z" />
    <path android:fillColor="#F8F5EE" android:pathData="M25,40h17v5.5h-17z" />
    <path android:fillColor="#F8F5EE" android:pathData="M36.5,40h5.5v15h-5.5z" />
    <path android:fillColor="#F8F5EE" android:pathData="M25,49.5h17v5.5h-17z" />

    <!-- 4 -->
    <path android:fillColor="#D40C1A" android:pathData="M45.5,40h5.5v16h-5.5z" />
    <path android:fillColor="#D40C1A" android:pathData="M45.5,50.5h17v5.5h-17z" />
    <path android:fillColor="#D40C1A" android:pathData="M57,40h5.5v28h-5.5z" />

    <!-- P -->
    <path android:fillColor="#F8F5EE" android:pathData="M66,40h5.5v28h-5.5z" />
    <path android:fillColor="#F8F5EE" android:pathData="M66,40h17v5.5h-17z" />
    <path android:fillColor="#F8F5EE" android:pathData="M77.5,40h5.5v15h-5.5z" />
    <path android:fillColor="#F8F5EE" android:pathData="M66,49.5h17v5.5h-17z" />
</vector>
