<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Único permiso, y solo para las partidas en vivo por sala. Todo lo demás
         —sobres, colección, plantilla, partidas contra la IA y amigos por código—
         funciona sin conexión y sin salir del dispositivo. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ANDROID TV (Nvidia Shield y compañía). Las dos van con required="false", así que
         NO cambian nada en un móvil: el mismo APK sirve para las dos cosas.

         · La pantalla táctil deja de ser obligatoria. Una tele no tiene, y sin esto el
           sistema da la aplicación por "no apta" para ese aparato.
         · Leanback declarado y no obligatorio: es la interfaz de Android TV.

         LO QUE NO SE TOCA ES EL BLOQUEO EN VERTICAL, y está medido: en la columna
         vertical que deja la tele (607x1080) las siete pantallas salen a 0 px de
         desborde, y soltándolo a horizontal (960x540) se rompen dos —Club 60 px y
         Plantilla 25 px—, porque el alto no da. La columna centrada ES la buena. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/banner_tv"
        android:theme="@style/TemaJaula">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Sin esto, en una Android TV la aplicación NO SALE en la pantalla de
                     inicio: hay que buscarla con un lanzador de los de sideload. Con la
                     categoría puesta aparece como cualquier otra, con su banner. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
